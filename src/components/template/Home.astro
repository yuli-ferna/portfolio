---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import DecryptedText from "../molecules/DecryptedText";
import BlurText from "../molecules/BlurText";
import ContactLinks from "../molecules/ContactLinks.astro";
import SplitText from "../SplitText";
import { motion } from "motion/react";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = t("home") ?? {};
const experience = t("experience") ?? {};
const currentYear = new Date().getFullYear();
const initDate = 2018;
const years = currentYear - initDate;
const description = t("home.description", { years });
const name = home["name"] ?? "Yuliana Fernandez";
const stats = home["stats"] ?? {};
const companies = new Set(
  (experience["positions"] ?? []).map((p: any) => p.companyName),
).size;

const tickerItems = [
  { sym: "✦", text: "Full-stack Dev" },
  { sym: "✧", text: "React" },
  { sym: "✦", text: "Node.js" },
  { sym: "✦", text: "TypeScript" },
  { sym: "✧", text: "Next.js" },
  { sym: "✦", text: "PostgreSQL" },
  { sym: "♥", text: "UI/UX" },
  { sym: "✧", text: "UCV Professor" },
  { sym: "●", text: "Open to work", ok: true },
];
---

<div
  class="flex flex-col-reverse md:flex-row items-center justify-around gap-6 lg:gap-20 w-full md:px-10 h-fit md:min-h-[calc(100vh+30px)] relative overflow-hidden"
  transition:animate="none"
>
  <!-- ═══════════════════════════════
       FLOATING PIXEL DECORATIONS
  ════════════════════════════════ -->
  <div class="pixel-floats" aria-hidden="true">
    <span class="fi fi-1">✦</span>
    <span class="fi fi-2">✧</span>
    <span class="fi fi-3">♥</span>
    <span class="fi fi-4">✦</span>
    <span class="fi fi-5">♥</span>
    <span class="fi fi-6">✦</span>
    <span class="fi fi-7">✧</span>
    <span class="fi fi-8">✦</span>
    <span class="fi fi-9">✧</span>
    <span class="fi fi-10">✧</span>
  </div>

  <!-- Pixel marquee ticker -->
  <div class="pixel-ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        [...tickerItems, ...tickerItems].map((item) => (
          <span class="ticker-item title">
            <span class={item.ok ? "px-ok" : undefined}>{item.sym}</span> {item.text}
          </span>
        ))
      }
    </div>
  </div>
  <!-- ═══════════════════════════════
       LEFT COLUMN
  ════════════════════════════════ -->
  <div class="hero-left">
    <DecryptedText
      client:load
      className="hero-kicker"
      text={home["greeting"] ?? "Hi, I'm"}
      animateOn="view"
      revealDirection="start"
      speed={60}
      sequential
    />

    <h1 class="hero-name">{name}</h1>

    <BlurText
      client:load
      text={description}
      className="hero-desc"
      delay={30}
      animateBy="words"
      direction="top"
    />

    <div class="hero-ctas">
      <a
        class="px-btn px-btn-primary"
        href={home["cvLink"] ?? "#"}
        target="_blank"
        rel="noopener noreferrer"
      >
        {home["cvLabel"] ?? "View my CV"} <span aria-hidden="true">↗</span>
      </a>
      <a class="px-btn" href="#contact">
        {home["talkLabel"] ?? "Let's talk"} <span aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="hero-stats">
      <div class="hero-stat">
        <dt class="px-muted">{stats["years"] ?? "years coding"}</dt>
        <dd class="px-mono">{years}+</dd>
      </div>
      <div class="hero-stat">
        <dt class="px-muted">{stats["companies"] ?? "companies"}</dt>
        <dd class="px-mono">{companies}</dd>
      </div>
      <div class="hero-stat">
        <dt class="px-muted">{stats["remote"] ?? "remote-ready"}</dt>
        <dd class="px-mono">100%</dd>
      </div>
    </dl>
  </div>

  <!-- ═══════════════════════════════
       RIGHT COLUMN — RETRO ID BADGE
  ════════════════════════════════ -->
  <div
    class="min-h-svh md:min-h-0 md:h-fit flex flex-col items-center justify-start md:justify-center pt-[60px] pb-[96px] md:p-0 w-full md:w-auto relative"
  >
    <!-- ══ LANYARD + ID CARD ══ -->
    <div class="lanyard-wrap">
      <!-- lanyard string SVG -->
      <svg
        class="lanyard-svg"
        viewBox="0 0 100 60"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <!-- left cord -->
        <path
          d="M 20 0 Q 20 30 50 58"
          stroke="var(--color-text-primary)"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"></path>
        <!-- right cord -->
        <path
          d="M 80 0 Q 80 30 50 58"
          stroke="var(--color-text-primary)"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"></path>
        <!-- clip ring -->
        <rect
          x="44"
          y="52"
          width="12"
          height="10"
          rx="2"
          fill="var(--color-container-primary)"
          stroke="var(--color-text-primary)"
          stroke-width="2.5"></rect>
      </svg>

      <!-- THE CARD -->
      <div class="id-card">
        <!-- card header bar -->
        <div class="card-header">
          <span class="status-dot-wrap flex h-7 px-2 items-center justify-center">
            <span class="status-green-dot"></span>
          </span>
          <span class="card-header-title title"
            >{home["status"] ?? "Open to work ✦"}</span
          >
          <span class="card-header-id title">#{currentYear}</span>
        </div>

        <!-- dashed divider -->
        <div class="card-divider"></div>

        <!-- avatar photo area -->
        <div class="card-photo-area">
          <div class="card-photo">
            <motion.img
              client:load
              initial={{ bottom: "4px", left: "4px" }}
              animate={{
                bottom: [0, "4px", 0],
                left: [0, "4px", 0],
                transition: { repeat: Infinity, duration: 8 },
              }}
              className="photo-img photo-red  mix-blend-normal"
              src={"/image_home_red.webp"}
              alt=""
            />
            <motion.img
              client:load
              initial={{ bottom: "-4px", left: "-4px" }}
              animate={{
                bottom: [0, "-4px", 0],
                left: [0, "-4px", 0],
                transition: { repeat: Infinity, duration: 8 },
              }}
              className="photo-img photo-blue  mix-blend-normal"
              src={"/image_home_blue.webp"}
              alt=""
            />
            <img
              class="photo-img mix-blend-normal"
              src={"/image_home.webp"}
              alt="Avatar"
            />
          </div>
        </div>

        <!-- dashed divider -->
        <div class="card-divider"></div>

        <!-- name + titles -->
        <div class="card-info">
          <p class="card-name title">{home["name"] ?? "Yuliana Fernandez"}</p>
          <div class="card-roles title text-lg">
            {
              home["titles"] &&
                home["titles"].map((title) => (
                  <DecryptedText
                    client:load
                    className="card-role-line"
                    text={title}
                    animateOn="view"
                    revealDirection="start"
                    speed={80}
                    sequential
                  />
                ))
            }
          </div>
        </div>

        <!-- dashed divider -->
        <div class="card-divider"></div>

        <!-- contact links row -->
        <div class="card-links">
          <ContactLinks />
        </div>

        <!-- bottom barcode decoration -->
        <div class="card-barcode" aria-hidden="true">
          <div class="barcode-bars">
            {
              Array.from({ length: 28 }).map((_, i) => (
                <span class={`bar bar-${i % 3}`} />
              ))
            }
          </div>
          <span class="barcode-num title">YF-{initDate}-{currentYear}</span>
        </div>
      </div><!-- /id-card -->

      <!-- floating pixel sparkles near the card -->
      <span class="card-spark cs1">✦</span>
      <span class="card-spark cs2">✧</span>
      <span class="card-spark cs3">♥</span>
    </div><!-- /lanyard-wrap -->

    
  </div>

</div>

<style>
  /* ═══════════════════════════════════════
     HERO LEFT COLUMN
  ═══════════════════════════════════════ */
  .hero-left {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 560px;
    padding: 48px 20px 120px;
    box-sizing: border-box;
    text-align: left;
  }
  @media (min-width: 768px) {
    .hero-left {
      padding: 0;
      margin-top: 6rem;
    }
  }

  .hero-left :global(.hero-kicker) {
    font-family: "Pixelify Sans", monospace;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .hero-name {
    margin: 0;
    font-family: "Pixelify Sans", sans-serif;
    font-weight: 600;
    font-size: clamp(48px, 7vw, 72px);
    line-height: 1;
  }

  .hero-left :global(.hero-desc) {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    max-width: 540px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero-stats {
    display: flex;
    margin: 8px 0 0;
    max-width: 540px;
    border: 1px solid var(--color-hair);
    border-radius: 17px;
    overflow: hidden;
  }
  .hero-stat {
    flex: 1;
    display: flex;
    flex-direction: column-reverse;
    padding: 16px 20px;
    border-right: 1px solid var(--color-hair);
  }
  .hero-stat:last-child {
    border-right: 0;
  }
  @media (max-width: 380px) {
    .hero-stat { padding: 12px 10px; min-width: 0; }
    .hero-stat dd { font-size: 24px; }
  }
  .hero-stat dt {
    font-size: 13px;
  }
  .hero-stat dd {
    margin: 0;
    font-size: 28px;
  }

  /* ═══════════════════════════════════════
     FLOATING BG DECORATIONS
  ═══════════════════════════════════════ */
  .pixel-floats {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .fi {
    position: absolute;
    font-size: 1.2rem;
    opacity: 0.32;
    animation: pixelFloat 4s ease-in-out infinite;
    color: var(--color-text-primary);
  }
  .fi-1 {
    top: 6%;
    left: 4%;
    font-size: 1.4rem;
    animation-delay: 0s;
    color: var(--color-spark-1);
  }
  .fi-2 {
    top: 12%;
    right: 6%;
    font-size: 0.9rem;
    animation-delay: 0.8s;
    color: var(--color-spark-2);
  }
  .fi-3 {
    top: 22%;
    left: 10%;
    font-size: 1.3rem;
    animation-delay: 0.3s;
  }
  .fi-4 {
    top: 55%;
    right: 4%;
    font-size: 1.4rem;
    animation-delay: 1.2s;
  }
  .fi-5 {
    top: 35%;
    left: 2%;
    font-size: 1rem;
    animation-delay: 1.9s;
    color: var(--color-spark-1);
  }
  .fi-6 {
    top: 78%;
    left: 6%;
    font-size: 1.2rem;
    animation-delay: 0.5s;
    color: var(--color-spark-1);
  }
  .fi-7 {
    top: 82%;
    right: 10%;
    font-size: 1rem;
    animation-delay: 1s;
    color: var(--color-spark-3);
  }
  .fi-8 {
    top: 48%;
    right: 2%;
    font-size: 1.2rem;
    animation-delay: 2.3s;
  }
  .fi-9 {
    top: 68%;
    right: 7%;
    font-size: 0.85rem;
    animation-delay: 1.6s;
    color: var(--color-spark-2);
  }
  .fi-10 {
    top: 42%;
    left: 5%;
    font-size: 1.1rem;
    animation-delay: 0.1s;
  }

  @keyframes pixelFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(8deg);
    }
  }

  /* ═══════════════════════════════════════
     LANYARD + CARD WRAP
  ═══════════════════════════════════════ */
  .lanyard-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* gentle swinging animation on the whole card */
    animation: cardSwing 6s ease-in-out infinite;
    transform-origin: top center;
  }

  @keyframes cardSwing {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }

  .lanyard-svg {
    width: 140px;
    display: block;
    margin-bottom: -4px; /* connect flush to card top */
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════
     ID CARD
  ═══════════════════════════════════════ */
  .id-card {
    width: 320px;
    background: var(--color-container-paper);
    border: 3px solid var(--color-text-primary);
    border-radius: 8px;
    box-shadow:
      5px 5px 0 var(--color-text-primary),
      inset 0 0 0 1px var(--color-container-primary);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* header bar */
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    background: var(--color-container-primary);
    border-bottom: 2px solid var(--color-text-primary);
  }

  .card-header-title {
    flex: 1;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-header-id {
    font-size: 0.55rem;
    opacity: 0.55;
    color: var(--color-text-primary);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* green dot */
  .status-dot-wrap {
    flex-shrink: 0;
  }
  .status-green-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 6px #4ade80;
    animation: greenPulse 1.5s ease-in-out infinite;
  }
  @keyframes greenPulse {
    0%,
    100% {
      box-shadow: 0 0 4px #4ade80;
      transform: scale(1);
    }
    50% {
      box-shadow: 0 0 12px #4ade80;
      transform: scale(1.3);
    }
  }

  /* dashed separator (pixel-art style) */
  .card-divider {
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      var(--color-text-primary) 0px,
      var(--color-text-primary) 6px,
      transparent 6px,
      transparent 10px
    );
    opacity: 0.35;
    margin: 0;
  }

  /* ── PHOTO ── */
  .card-photo-area {
    display: flex;
    justify-content: center;
    padding: 0.85rem 0 0.65rem;
    background: var(--color-container-paper);
  }

  .card-photo {
    position: relative;
    width: 180px;
    height: 200px;
    border: 2.5px solid var(--color-text-primary);
    box-shadow: 3px 3px 0 var(--color-text-primary);
    overflow: hidden;
    background: var(--color-container-primary);
    border-radius: 4px;
    flex-shrink: 0;
  }

  .photo-img {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .photo-red {
    opacity: 0.45;
    mix-blend-mode: lighten;
  }
  .photo-blue {
    opacity: 0.45;
  }

  /* ── NAME + ROLES ── */
  .card-info {
    padding: 0.7rem 0.8rem 0.6rem;
    text-align: center;
    background: var(--color-container-paper);
  }

  .card-name {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    margin: 0 0 0.35rem;
  }

  .card-roles {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .card-role-line {
    font-size: 0.62rem !important;
    letter-spacing: 0.06em;
    color: var(--color-text-primary);
    opacity: 0.75;
    font-family: "Pixelify Sans", monospace !important;
  }

  /* ── LINKS ── */
  .card-links {
    padding: 0.6rem 0.5rem;
    display: flex;
    justify-content: center;
    background: var(--color-container-paper);
  }

  /* shrink the ContactLinks icons to fit the card */
  .card-links :global(.icon-button) {
    width: 36px !important;
    height: 36px !important;
  }
  .card-links :global(svg) {
    width: 22px !important;
    height: 22px !important;
  }

  /* ── BARCODE ── */
  .card-barcode {
    padding: 0.5rem 0.7rem 0.55rem;
    background: var(--color-container-primary);
    border-top: 2px solid var(--color-text-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .barcode-bars {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 22px;
  }

  .bar {
    display: inline-block;
    background: var(--color-text-primary);
    border-radius: 0;
  }
  /* three bar heights for variety */
  .bar-0 {
    width: 2px;
    height: 22px;
  }
  .bar-1 {
    width: 1px;
    height: 16px;
  }
  .bar-2 {
    width: 3px;
    height: 19px;
  }

  .barcode-num {
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    color: var(--color-text-primary);
    opacity: 0.6;
  }

  /* ── SPARKLES AROUND CARD ── */
  .card-spark {
    position: absolute;
    pointer-events: none;
    font-size: 1rem;
    opacity: 0.5;
    animation: pixelFloat 3.5s ease-in-out infinite;
  }
  .cs1 {
    bottom: 2rem;
    left: -1.5rem;
    animation-delay: 0s;
    color: var(--color-spark-1);
    font-size: 1.1rem;
  }
  .cs2 {
    top: 3.5rem;
    right: -1.5rem;
    animation-delay: 1.1s;
    color: #a5f3fc;
    font-size: 0.85rem;
  }
  .cs3 {
    bottom: 5rem;
    right: -1.2rem;
    animation-delay: 1.8s;
    color: #efb8c8;
    font-size: 0.9rem;
  }

  /* ═══════════════════════════════════════
     PIXEL CONTACT BUTTON
  ═══════════════════════════════════════ */
  .pixel-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    font-family: "Pixelify Sans", "Courier New", monospace;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    background: var(--color-container-primary);
    border: 2.5px solid var(--color-text-primary);
    border-radius: 4px;
    box-shadow: 3px 3px 0 var(--color-text-primary);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease,
      background 0.15s ease;
    position: relative;
    z-index: 1;
  }
  .pixel-contact-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-text-primary);
    background: #efb8c8;
  }
  .pixel-contact-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--color-text-primary);
  }
  .btn-px-arrow {
    transition: transform 0.2s;
  }
  .pixel-contact-btn:hover .btn-px-arrow {
    transform: translateX(5px);
  }

  /* ═══════════════════════════════════════
     TICKER
  ═══════════════════════════════════════ */
  .pixel-ticker {
    position: absolute;
    top: 8rem;
    left: 0;
    right: 0;
    overflow: hidden;
    border-top: 2px solid var(--color-text-primary);
    border-bottom: 2px solid var(--color-text-primary);
    background: var(--color-container-primary);
    padding: 0.28rem 0;
    opacity: 0.65;
    z-index: 15;
    pointer-events: none;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: tickerScroll 20s linear infinite;
  }
  .ticker-item {
    font-family: "Pixelify Sans", "Courier New", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
    padding: 0 2.5rem;
    white-space: nowrap;
  }
  @keyframes tickerScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ═══════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════ */
  @media (max-width: 640px) {
    .fi-3,
    .fi-4,
    .fi-8,
    .fi-10 {
      display: none;
    }
    .pixel-ticker {
      display: none;
    }
    .cs1,
    .cs2,
    .cs3 {
      display: none;
    }
    .id-card {
      width: min(320px, calc(100vw - 44px));
    }
    .lanyard-svg {
      width: 110px;
    }
    .card-photo {
      width: 150px;
      height: 170px;
    }
  }
</style>
