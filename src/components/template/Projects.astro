---
import { getLangFromUrl, useTranslations, getImage } from "../../i18n/utils";
import TechTag from "../atoms/TechTag.astro";
import { localLang } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = t("projects") ?? {};
// The remote locale (portfolio-assets) may lag behind; fall back to the bundled copy.
const local = (localLang() as Record<string, any>)[lang]?.projects ?? {};
const list = [...(projects["list"] ?? local["list"] ?? [])];
const portal = projects["portal"] ?? local["portal"] ?? {};
const archiveUrl = "https://yuli-ferna.github.io/";
const folders = ["three.js", "react", "demos"];
---

<div class="px-section prj">
  <div class="prj-intro">
    <h2 class="px-h2 projects-title">{projects["title"]}</h2>
    <p class="px-lead section-desc">{projects["description"]}</p>
  </div>

  {
    list.length > 0 && (
      <div class="prj-grid">
        {list.map((p: any) => (
          <article class="px-card prj-card">
            <div class="px-bar" aria-hidden="true">
              <span class="px-dot px-dot-red"></span><span class="px-dot px-dot-yellow"></span><span class="px-dot px-dot-green"></span>
              <span class="px-bar-title">{p.meta}</span>
            </div>
            <img class="prj-shot" src={getImage(p.image)} alt={p.title} loading="lazy" />
            <div class="prj-body">
              <h3 class="prj-title">{p.title}</h3>
              <p class="prj-desc">{p.description}</p>
              <div class="prj-tags">
                {(p.tags ?? []).map((tag: string) => (
                  <TechTag text={tag} />
                ))}
              </div>
              <div class="prj-links">
                {(p.links ?? []).map((l: any) => (
                  <a class="px-link" href={l.link} target="_blank" rel="noopener noreferrer">
                    {l.text} ↗
                  </a>
                ))}
                {p.private && <span class="px-mono px-muted prj-private">{p.private}</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }

  <a
    href={archiveUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="px-card portal pixel-btn"
  >
    <div class="portal-window">
      <div class="px-bar" aria-hidden="true">
        <span class="px-dot px-dot-red"></span><span class="px-dot px-dot-yellow"></span><span class="px-dot px-dot-green"></span>
        <span class="px-bar-title">C:\yuli\projects.exe</span>
      </div>
      <div class="portal-desktop" aria-hidden="true">
        {
          folders.map((name, i) => (
            <span class="folder" style={`transition-delay: ${i * 0.05}s`}>
              <svg width="44" height="36" viewBox="0 0 22 18">
                <path d="M1 3h7l2 2h11v12H1z" fill="#fef7c3" stroke="#21242a" stroke-width="1.2" />
                <path d="M1 7h20" stroke="#21242a" stroke-width="1.2" />
              </svg>
              <span class="folder-name">{name}</span>
            </span>
          ))
        }
      </div>
    </div>
    <div class="portal-copy">
      <p class="px-mono px-muted portal-kicker">✦ {portal["kicker"] ?? "THE FULL ARCHIVE"}</p>
      <h3 class="portal-title">{portal["title"] ?? projects["cta"]}</h3>
      <p class="portal-desc">{portal["description"] ?? projects["description"]}</p>
      <span class="portal-btn">
        {portal["cta"] ?? projects["cta"]}<span class="px-blink" aria-hidden="true">_</span>
      </span>
    </div>
  </a>
</div>

<style>
  .prj {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .prj-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prj-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 700px) {
    .prj-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .prj-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .prj-card {
    display: flex;
    flex-direction: column;
  }
  .prj-shot {
    width: 100%;
    height: 170px;
    object-fit: cover;
    background: var(--color-bg-default);
    border-bottom: 3px solid var(--color-text-primary);
  }
  .prj-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .prj-title {
    margin: 0;
    font-family: "Pixelify Sans", sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
  }
  .prj-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .prj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .prj-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
    margin-top: auto;
    padding-top: 4px;
  }
  .prj-private {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 15px;
  }

  /* ── Portal to projects.exe ── */
  .portal {
    display: grid;
    grid-template-columns: 1fr;
    text-decoration: none;
    color: var(--color-text-primary);
    box-shadow: 6px 6px 0 0 var(--shadow-hard);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  @media (min-width: 800px) {
    .portal {
      grid-template-columns: 1.1fr 1fr;
    }
    .portal-window {
      border-right: 3px solid var(--color-text-primary);
      border-bottom: 0 !important;
    }
  }
  .portal:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 0 var(--shadow-hard);
  }
  .portal:active {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 0 var(--shadow-hard);
  }
  .portal:focus-visible {
    outline: 3px solid var(--color-text-primary);
    outline-offset: 4px;
  }

  .portal-window {
    display: flex;
    flex-direction: column;
    border-bottom: 3px solid var(--color-text-primary);
  }
  .portal-desktop {
    flex: 1;
    min-height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    font-family: "VT323", monospace;
    color: #21242a;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.38) 2px, transparent 2px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.38) 2px, transparent 2px),
      linear-gradient(237deg, #a4bdf5 0%, #eecfca 55%, #f984b3 100%);
    background-size: 28px 28px, 28px 28px, 100% 100%;
  }
  .folder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 18px;
    transition: transform 0.2s ease;
  }
  .portal:hover .folder {
    transform: translateY(-4px);
  }
  .folder-name {
    background: #fff1f7;
    padding: 0 6px;
  }

  .portal-copy {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .portal-kicker {
    margin: 0;
    font-size: 14px;
  }
  .portal-title {
    margin: 0;
    font-family: "Pixelify Sans", sans-serif;
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
  }
  @media (min-width: 768px) {
    .portal-title {
      font-size: 34px;
    }
  }
  .portal-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }
  .portal-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 22px;
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
    border: 2px solid var(--color-text-primary);
    border-radius: 12px;
    font-family: "Pixelify Sans", monospace;
    font-size: 18px;
    transition: background 0.15s ease;
  }
  .portal:hover .portal-btn {
    background: #fd64ac;
    color: #21242a;
  }

  @media (prefers-reduced-motion: reduce) {
    .portal,
    .portal:hover,
    .portal:hover .folder {
      transition: none;
      transform: none;
    }
  }
</style>
